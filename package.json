{
  "name": "bevy-react-workspace",
  "private": true,
  "workspaces": [
    "js",
    "examples/demos/ui",
    "examples/minimal/ui",
    "examples/stress/ui",
    "examples/layers-stress/ui",
    "examples/arcana/ui",
    "examples/atrium/ui",
    "examples/epoch/ui",
    "docs"
  ],
  "scripts": {
    "lint": "eslint . && npm run typecheck && npm run format:check",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write . && cargo fmt",
    "format:check": "prettier --check . && cargo fmt --check",
    "style:generate": "UPDATE_STYLE_TS=1 cargo test -p bevy_react_core --lib style::ts::tests::core_style_ts_is_current",
    "elements:generate": "UPDATE_ELEMENT_TS=1 cargo test -p bevy_react_core --lib element::ts::tests::core_element_ts_is_current",
    "reference:generate": "UPDATE_LIBRARY_TS=1 cargo test --workspace --test library_ts",
    "generate": "npm run style:generate && npm run elements:generate && npm run reference:generate",
    "docs": "tsx docs/src/build.ts",
    "screenshots": "node screenshots/capture.mjs",
    "deploy:site": "tsx docs/src/build.ts && npm run build:web:prod -w demos -- --build-only && cp -r examples/demos/ui/dist docs/dist/demo && gh-pages -d docs/dist --dotfiles --no-history -b gh-pages"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.20.0"
  }
}
